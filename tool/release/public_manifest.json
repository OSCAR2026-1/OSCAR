{
  "schema_version": "oscar-public-release/v1",
  "archive_root": "oscar-tool",
  "include": [
    ".gitignore",
    "LICENSE*",
    "NOTICE",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "pyproject.toml",
    "oscar.py",
    "evaluate.py",
    "oscar/*.py",
    "oscar/**/*.py",
    "oscar/schemas/*.json",
    "benchmark/README.md",
    "examples/*.py",
    "examples/*.json",
    "scripts/build_public_release.py",
    "scripts/__init__.py",
    "release/public_manifest.json",
    "tests/test_component_origins.py",
    "tests/test_component_path.py",
    "tests/test_cross_layer_graph.py",
    "tests/test_cross_layer_graph_view.py",
    "tests/test_effect_modeling.py",
    "tests/test_failure_diagnostics.py",
    "tests/test_impact_assessment.py",
    "tests/test_localization.py",
    "tests/test_repair_predicate.py",
    "tests/test_public_release.py",
    "tests/fixtures/blind_case.json",
    "tests/fixtures/blind_case_insufficient.json",
    "tests/fixtures/blind_prediction.jsonl",
    "tests/fixtures/emit_blind_evidence.py",
    "tests/fixtures/emit_recorder.py",
    "tests/fixtures/environment_manifest_mismatch.json",
    "tests/fixtures/mcp_fixture_server.py",
    "tests/fixtures/mcp_http_fixture_server.py"
  ],
  "exclude": [
    "oscar/tools/build_formal_cases.py"
  ],
  "required": [
    "README.md",
    "pyproject.toml",
    "oscar.py",
    "oscar/cli.py",
    "oscar/runtime/shared_host.py",
    "oscar/schemas/prediction.schema.json"
  ]
}
