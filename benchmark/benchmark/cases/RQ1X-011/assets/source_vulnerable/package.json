{
  "name": "cv-email-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for CV queries and email notifications",
  "type": "module",
  "main": "dist/server/index.js",
  "bin": {
    "cv-email-server": "dist/server/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server/index.js",
    "dev": "tsx src/server/index.ts",
    "watch": "tsx watch src/server/index.ts",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "http": "tsx src/server/http.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cv",
    "resume",
    "email",
    "assistant"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@types/cors": "^2.8.19",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "nodemailer": "^6.9.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^20.19.13",
    "@types/nodemailer": "^6.4.14",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
